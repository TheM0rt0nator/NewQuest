{
  "name": "SecretQuest",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "SecretQuest": {
        "$className": "Folder",
        "Config": { "$path": "secret/shared/Config.lua" },
        "CelebrationFinished": { "$className": "RemoteEvent" },
        "AnniversaryQuestConfig": { "$path": "secret/shared/AnniversaryQuestConfig.lua" },
        "QuestCelebration": { "$path": "src/ReplicatedStorage/Modules/QuestCelebration.lua" },
        "QuestUI": { "$path": "src/ReplicatedStorage/Modules/QuestUI.lua" },
        "QuestUISound": { "$path": "src/ReplicatedStorage/Modules/QuestUISound.lua" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "SecretQuest": { "$path": "secret/server" },
      "SecretQuestPackages": {
        "$className": "Folder",
        "ProfileStore": { "$path": "ServerPackages/ProfileStore.luau" }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "SecretQuest": { "$path": "secret/client/SecretQuest.client.lua" }
      }
    }
  }
}
