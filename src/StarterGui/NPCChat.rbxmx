<Item class="ModuleScript" referent="RBX3"><Properties>
<ProtectedString name="Source">-- roblox services

local ProximityPromptService = game:GetService('ProximityPromptService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')

-- knit

local Knit = require(ReplicatedStorage.Packages.Knit)

local _LayoutUtil = require(Knit.Modules.Util.LayoutUtil)

local Controller = {
	UI = script.Parent,

	IsOpen = false,
	CurrentPage = 1,
	Pages = {}
}

-- constants

local UI = Controller.UI
local DIALOG_LABEL = UI:FindFirstChild('Dialog')
local OPTIONS_FRAME = UI:FindFirstChild('OptionsFrame')
local OPTION_TEMPLATE = OPTIONS_FRAME and OPTIONS_FRAME:FindFirstChild('Template')
local CUTOFF_DIST = 20

-- variables

-- methods

function Controller:ClearOptions()
	if not OPTIONS_FRAME then return end
	
	for _, child in ipairs(OPTIONS_FRAME:GetChildren()) do
		if child:IsA('GuiButton') and child ~= OPTION_TEMPLATE then
			child:Destroy()
		end
	end
end

function Controller:DisplayOptions(options)
	if not OPTIONS_FRAME or not OPTION_TEMPLATE then
		warn(&quot;OptionsFrame or Template not found in UI&quot;)
		return
	end
	
	self:ClearOptions()
	
	for index, option in ipairs(options) do
		local optionButton = OPTION_TEMPLATE:Clone()
		optionButton.Name = &quot;Option&quot; .. index
		optionButton.Visible = true
		optionButton.TextLabel.Text = option.Text or &quot;Option &quot; .. index
		
		-- Set position based on index
		optionButton.LayoutOrder = index
		
		optionButton.MouseButton1Click:Connect(function()
			-- Execute the option's callback if it exists
			if option.OnSelect then
				option.OnSelect()
			end
			
			-- Execute the page complete callback
			if self.onPageComplete then
				task.spawn(function()
					self.onPageComplete(self.CurrentPage)
				end)
			end

			if option.NextConversation then
				local nextConversation = option.NextConversation
				if typeof(option.NextConversation) == 'function' then
					nextConversation = option.NextConversation()
				end

				self:Close()
				self:Open(nextConversation, self.NPC)
				return
			end
			
			-- Navigate to next page or specific page if defined
			if option.NextPage then
				self.CurrentPage = option.NextPage
			else
				self.CurrentPage = self.CurrentPage + 1
			end
			
			-- Check if we've reached the end
			if self.CurrentPage &gt; #self.Pages or option.ShouldClose then
				self:Close()
				return
			end
			
			-- Update to new page
			self:UpdatePage()
		end)
		
		optionButton.Parent = OPTIONS_FRAME
	end
	
	-- Hide continue button when options are shown
	UI.Continue.Visible = false
	OPTIONS_FRAME.Visible = true
end

function Controller:UpdatePage()
	local pageData = self.Pages[self.CurrentPage]
	DIALOG_LABEL.Text = pageData.Text
	
	-- Check if this page has options
	if pageData.Options and #pageData.Options &gt; 0 then
		self:DisplayOptions(pageData.Options)
	else
		-- No options, show continue button
		self:ClearOptions()
		if OPTIONS_FRAME then
			OPTIONS_FRAME.Visible = false
		end
		UI.Continue.Visible = true
	end
end

-- default

function Controller:Open(pages, npcObj, onFunctionComplete, onPageComplete, startPage)
	if self.IsOpen then return end

	if startPage then
		self.CurrentPage = startPage
	else
		self.CurrentPage = 1
	end

	self.onFunctionComplete = onFunctionComplete
	self.onPageComplete = onPageComplete

	ProximityPromptService.Enabled = false

	self.Pages = pages
	self.NPC = npcObj
	
	UI.Visible = true
	self.IsOpen = true
	
	-- Update the page to display text and options
	self:UpdatePage()

	if npcObj then
		task.spawn(function()
			local char = Knit.Player.Character
			while char and char.PrimaryPart and char:IsDescendantOf(workspace) do
				if not npcObj.NPC or not npcObj.NPC:FindFirstChild('HumanoidRootPart') then
					self:Close()
					break
				end
				
				local dist = (char.PrimaryPart.Position - npcObj.NPC.HumanoidRootPart.Position).Magnitude
				if dist &gt;= CUTOFF_DIST then
					self:Close()
					break
				end

				task.wait(0.5)
			end

			self:Close()
		end)
	end
end

function Controller:Close()
	if not self.IsOpen then return end

	self.CurrentPage = 1
	self:ClearOptions()
	if OPTIONS_FRAME then
		OPTIONS_FRAME.Visible = false
	end
	UI.Visible = false
	UI.Continue.Visible = true
	self.IsOpen = false
	if self.NPC and self.NPC.ChatClosed then
		-- Call the NPC's chat closed function if it exists
		self.NPC:ChatClosed()
	end

	ProximityPromptService.Enabled = true
end

function Controller:ToggleVisibility()
	self[self.IsOpen and 'Close' or 'Open'](self)
end

function Controller:Start()
	UI.Continue.MouseButton1Click:Connect(function()
		local currentPageData = self.Pages[self.CurrentPage]
		if currentPageData.Function then
			currentPageData.Function()

			if self.onFunctionComplete then
				self.onFunctionComplete(self.CurrentPage)
			end
		end

		task.spawn(function()
			if self.onPageComplete then
				self.onPageComplete(self.CurrentPage)
			end
		end)

		local prevPage = self.Pages[self.CurrentPage]
		
		self.CurrentPage = self.CurrentPage + 1
		if self.CurrentPage &gt; #self.Pages or prevPage.ShouldClose then
			self:Close()
			return
		end

		self:UpdatePage()
	end)

	UI.Close.MouseButton1Click:Connect(function()
		self:Close()
	end)
end

function Controller:Init()

end

return Controller</ProtectedString>
